{
  "name": "@rareformlabs/vue-signature",
  "version": "1.1.0",
  "description": "A Vue 3 signature pad component with SVG and Canvas renderers.",
  "author": "RareFormLabs",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/RareFormLabs/vue-signature.git"
  },
  "bugs": {
    "url": "https://github.com/RareFormLabs/vue-signature/issues"
  },
  "homepage": "https://rareformlabs.github.io/vue-signature/",
  "keywords": [
    "vue",
    "vue3",
    "signature",
    "signature-pad",
    "canvas",
    "svg"
  ],
  "engines": {
    "node": ">=22.23.2"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js",
      "require": "./dist/canvas.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "vue-tsc --project tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "dev": "vite --config vite.demo.config.ts --host 0.0.0.0",
    "test": "npm run test:types && npm run test:lint && npm run test:fmt && npm run test:unit",
    "test:types": "vue-tsc --noEmit",
    "test:lint": "oxlint",
    "test:fmt": "oxfmt --check",
    "test:unit": "vitest run",
    "fmt": "oxfmt --write",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:typescript-native-bridge@latest",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
